# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local AXO checkout used by the parity harness. Never vendor a product into PIL —
# the harness points at a checkout, it does not contain one (I-3).
/.axo/

# Raw, unscrubbed capture output. Fixtures enter this repo only after scrubbing;
# this pattern is a backstop against someone dropping a raw dump in by accident.
/raw-capture/
*.raw.json

# Environment files. PIL has none today and needs none — it is a library with no runtime
# configuration — but PIL_CAPTURE_SALT is a real secret in the capture workflow and the
# obvious place for someone to park it locally is a .env beside the harness. AXO ignores
# these already; PIL did not, which IDI-197 caught.
.env
.env.*
!.env.example

.DS_Store
